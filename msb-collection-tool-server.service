[Unit]
Description=MSB Collection Copilot tool server with Zalo direct-bot bridge
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/opt/msb-collection-copilot
Environment=PYTHONPATH=/opt/msb-collection-copilot/src
Environment=TOOL_HOST=127.0.0.1
Environment=TOOL_PORT=18080
Environment=ZALO_INBOUND_SHARED_SECRET_FILE=/root/.config/msb-collection/zalo-inbound-shared-secret
Environment=ZALO_BOT_TOKEN_FILE=/root/.config/msb-collection/zalo-bot-token
Environment=MSB_ZALO_HEARTBEAT_FILE=/opt/msb-collection-copilot/.zalo-worker-heartbeat
ExecStart=/bin/bash -c 'set -a; source /opt/msb-collection-copilot/.env; set +a; export SYNTHETIC_DATA_DIR=/opt/msb-collection-copilot/build/synthetic-data; exec /root/miniconda3/bin/python3.14 /opt/msb-collection-copilot/tool_server.py'
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/msb-collection-copilot
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
