# GreenNode AgentBase IAM
GREENNODE_CLIENT_ID=
GREENNODE_CLIENT_SECRET=

# GreenNode MaaS
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_MODEL=z-ai/glm-5.2-hackathon
LLM_API_KEY=
QWEN_FAST_MODEL=qwen/qwen3.6-flash

# GreenNode Vector Database (live Project Knowledge RAG index, TASK-011H-A.1/B)
# GRENNODE_VDB_INDEX must name the V2 index provisioned for live retrieval.
GRENNODE_VDB_ENDPOINT=
GRENNODE_VDB_INDEX=msb-collection-knowledge-v2
GRENNODE_VDB_USER=
GRENNODE_VDB_PASSWORD=
# deterministic | local-multilingual | local-e5 | greennode-maas
RAG_EMBEDDING_PROVIDER=local-multilingual

# Collection Tool
COLLECTION_TOOL_BASE_URL=http://127.0.0.1:8000
COLLECTION_TOOL_PUBLIC_URL=
COLLECTION_TOOL_API_KEY=
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=change-me

# TASK-018: Agent-first conversation orchestration feature flag
# When true and LLM is available, AgentBase is the primary semantic planner.
# When false or LLM unavailable, the deterministic resolver is used (Level 2).
AGENT_FIRST_CONVERSATION_ENABLED=false
